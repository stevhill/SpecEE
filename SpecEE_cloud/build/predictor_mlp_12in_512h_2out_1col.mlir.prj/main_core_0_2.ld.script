
MEMORY
{
   program (RX) : ORIGIN = 0, LENGTH = 0x0020000
   data (!RX) : ORIGIN = 0x77C40, LENGTH = 0x83C0
}
ENTRY(__start)
SECTIONS
{
  . = 0x0;
  .text : {
     /* the __start symbol has to come at address zero. */
     *crt0.o(.text*)
     _ctors_start = .;
     _init_array_start = .;
     KEEP(SORT(*.init_array))
     _ctors_end = .;
     _init_array_end = .;
     _dtors_start = .;
     _dtors_end = .;
     *(.text*)
  } > program
  .data : {
     *(.data*)
     *(.rodata*)
  } > data
  .comment : {
     *(.comment*)
  }
  .symtab : {
     *(.symtab)
  }
  .shstrtab : {
     *(.shstrtab)
  }
  .strtab : {
     *(.strtab)
  }
  .stack_sizes : {
     *(.stack_sizes)
  }

. = 0x70000;
_sp_start_value_DM_stack = .;
. += 0x400; /* stack */
/* No tile with memory exists to the south. */
. = 0x40000;
. += 0x10000;
/* No tile with memory exists to the west. */
. = 0x50000;
. += 0x10000;
. = 0x77C38;
mlp_output_buff_0 = .;
. += 0x4;
. = 0x77C3C;
mlp_output_buff_1 = .;
. += 0x4;
. = 0x77C00;
mlp_input_cons_buff_0 = .;
. += 0x18;
. = 0x77C18;
mlp_input_cons_buff_1 = .;
. += 0x18;
. = 0x70400;
fc1_weight = .;
. += 0x6000;
. = 0x76400;
fc2_weight = .;
. += 0x1000;
. = 0x77400;
hidden_fc1 = .;
. += 0x800;
. = 0x77C30;
_anonymous0 = .;
. += 0x8;
  .bss : { *(.bss*) } > data
}
INPUT(mv.o)
PROVIDE(main = core_0_2);
